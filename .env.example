# Copy this file to .env and fill in your real values.
# Never commit .env — it's already gitignored.

# ── v3 (current, default) ────────────────────────────────────────────────
# Required for every v3 tool. Get these from the Flutterwave Dashboard →
# Settings → API Keys (the "Public Key / Private Key / Encryption Key" view).
FLW_SECRET_KEY=
# Required only for card-charge tools (charge_card). 3DES-ECB payload encryption.
FLW_ENCRYPTION_KEY=

# Optional, rarely needed: overrides the v3 API path segment appended to
# https://api.flutterwave.com/. Defaults to "v3". Leave unset unless you
# know you need something else — unrelated to the v3/v4 split below.
FLW_VERSION=v3

# ── v4 (opt-in) ───────────────────────────────────────────────────────────
# Uncomment to register the v4 tools instead of v3. Names are listed in
# V4_ACCEPTED_TOOLS in src/config/acceptedTools.ts. v4 uses the OAuth pair
# and encryption key below; FLW_SECRET_KEY can stay empty.
# FLW_API_VERSION=v4

# Dashboard → Settings → API Keys → v4 keys (sandbox or live).
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=

# Base64 AES-256-GCM key from that same v4 keys view. Decoded length is 32 bytes.
FLW_ENCRYPTION_KEY_V4=

# Which v4 environment to hit. Defaults to "sandbox" for safety — the server
# will not talk to production unless you explicitly opt in.
#   sandbox    → https://developersandbox-api.flutterwave.com
#   production → https://f4bexperience.flutterwave.com
FLW_ENVIRONMENT=sandbox
