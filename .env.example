# Copy this file to .env and fill in your real values.
# Never commit .env — it's already gitignored.

# ── v3 (current, default) ────────────────────────────────────────────────
# Required for every v3 tool. Get these from the Flutterwave Dashboard →
# Settings → API Keys (the "Public Key / Private Key / Encryption Key" view).
FLW_SECRET_KEY=
# Required only for card-charge tools (charge_card). 3DES-ECB payload encryption.
FLW_ENCRYPTION_KEY=

# Optional, rarely needed: overrides the v3 API path segment appended to
# https://api.flutterwave.com/. Defaults to "v3". Leave unset unless you
# know you need something else — unrelated to the v3/v4 split below.
FLW_VERSION=v3

# ── v4 (in progress, opt-in) ──────────────────────────────────────────────
# Not implemented yet for tool registration — leave commented (defaults to v3).
# When wired up, v4 will require the OAuth vars below instead of FLW_SECRET_KEY.
# FLW_API_VERSION=v4

# OAuth 2.0 client-credentials pair. Get these from the Flutterwave Dashboard
# → Settings → API Keys → "Switch to v4 live API keys" (or the sandbox
# equivalent in test mode). NOT the same as FLW_SECRET_KEY above — v4 uses
# OAuth, not a static bearer key.
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=

# AES-256-GCM card field encryption key for v4. Shown as a separate field in
# the same v4 API Keys dashboard view. May or may not be the same value as
# the v3 FLW_ENCRYPTION_KEY above — don't assume, copy it explicitly.
# Must be base64 that decodes to exactly 32 bytes (incompatible with v3's key).
FLW_ENCRYPTION_KEY_V4=

# Which v4 environment to hit. Defaults to "sandbox" for safety — the server
# will not talk to production unless you explicitly opt in.
#   sandbox    → https://developersandbox-api.flutterwave.com
#   production → https://f4bexperience.flutterwave.com
FLW_ENVIRONMENT=sandbox
